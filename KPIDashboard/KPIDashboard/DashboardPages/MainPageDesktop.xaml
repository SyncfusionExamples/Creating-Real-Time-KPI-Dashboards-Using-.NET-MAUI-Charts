<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KPIDashboard.DashboardPages.MainPageDesktop"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
    xmlns:local="clr-namespace:KPIDashboard" Padding="12"
    BackgroundColor="#0B1220">

    <!-- BindingContext will be set from code-behind via DI -->

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="TextLight">#E5E7EB</Color>
            <SolidColorBrush x:Key="CardBg" Color="#111827" />
            <SolidColorBrush x:Key="CardStroke" Color="#1F2937" />

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextLight}" />
            </Style>

            <Style x:Key="CardTitle" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextColor" Value="{StaticResource TextLight}"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBg}"/>
                <Setter Property="Stroke" Value="{StaticResource CardStroke}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Padding" Value="12"/>
            </Style>

            <Style x:Key="InsightCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="10"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,*" 
          ColumnDefinitions="3*,2*" 
          RowSpacing="12" ColumnSpacing="12" Padding="12">

        <!-- Title row -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Padding="4">
            <Border Style="{StaticResource Card}">
                <Border.StrokeShape>
  
                  <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <Grid>
                    <HorizontalStackLayout Spacing="0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center">
                        <!-- Title icon chip -->
                        <Path Margin="5,5,0,0" Fill="White" WidthRequest="45" HeightRequest="45" Data="M15.546991,6.2789833L30.027005,6.2789833 30.027005,12.246996 31.999986,12.246996 31.999986,18.141976 30.027005,18.141976 30.027005,24.051983 10.289006,24.051983 10.289006,22.08299 12.25702,22.08299 12.802001,22.08299 28.058015,22.08299 28.058015,18.141976 28.05403,18.141976 28.05403,12.246996 28.058015,12.246996 28.058015,8.2489831 16.303032,8.2489831C16.184014,7.786978 16.064996,7.3250031 15.876031,6.8829865 15.788019,6.6759862 15.657038,6.480979 15.546991,6.2789833z M7.2908282,3.2920065L3.3867488,7.4790155C3.1087427,7.7760161,2.9157391,8.0430167,2.7917366,8.2940171L2.7777362,8.3240173C2.3497276,9.2090192 2.1807241,10.207021 2.2897263,11.213023 2.5306687,13.441465 4.1954684,15.262973 6.320055,15.697015L6.3829889,15.708411 6.3829889,8.3199975 8.3820268,8.3199975 8.3820268,15.687145 8.5701938,15.644285C9.4486807,15.420981 10.255263,14.959281 10.913902,14.29103 11.879922,13.310028 12.412932,12.004025 12.412933,10.613022 12.412932,9.8930206 12.27093,9.1960192 11.990924,8.5420177 11.831921,8.170017 11.577915,7.7980162 11.234908,7.4390155z M7.2748275,0L12.869942,5.8830122C13.363952,6.4020133 13.78296,6.9940145 14.065966,7.6550159 14.453974,8.5610178 14.668978,9.5620198 14.668978,10.613022 14.668978,14.316249 12.002806,17.388006 8.5115747,17.959583L8.3820268,17.978983 8.3820268,24.051973 6.3829889,24.051973 6.3829889,17.992398 6.1856332,17.965751C2.9698515,17.457594 0.40315628,14.759468 0.045681,11.456024 -0.11632252,9.9590206 0.15968323,8.5380177 0.76069546,7.309015 0.76269531,7.3060151 0.76369476,7.3040152 0.76469517,7.3010151 1.0127001,6.7970141 1.3547068,6.3490131 1.7357149,5.9400123z"/>
                        <Label Text="Real-Time KPI Dashboard for Sales performance analysis"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#E5E7EB" Padding="0,8,0,0" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>
        <!-- Insights row -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Insight 1: Momentum -->
            <Border Grid.Column="0" Style="{StaticResource InsightCard}" HeightRequest="88">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" VerticalOptions="Center" Padding="8,6">
                    <!-- Icon chip -->
                    <Border BackgroundColor="#3B82F6"
                       WidthRequest="70" HeightRequest="52"
                       VerticalOptions="Center" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Path x:Name="MomentumIcon"    Margin="15,5,0,0" Fill="Black" WidthRequest="50" HeightRequest="40" Data ="M17.276001,18.666992L23.999023,25.333984 26.666016,25.333984 26.666016,26.666992 22.666016,26.666992 17.333008,21.139038 11.999023,26.666992 5.3319702,26.666992 5.3319702,25.333984 10.859985,25.222046z M16.000977,6.6669922L25.333984,18.666992 26.666992,18.666992 26.666992,20 24,20 16,9.3330078 10.666992,20 5.3339844,20 5.3339844,18.666992 9.3339844,18.666992z M2.6660156,2.6660156L2.6660156,29.333008 29.333008,29.333008 29.333008,2.6660156z M0,0L32,0 32,32 0,32z"/>
                    </Border>
                    <!-- Value + Name -->
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Margin="2,0,0,0">
                        <Label Text="{Binding Insights[0].Value}"
                       FontSize="20" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Insights[0].Name}"
                       FontSize="12" FontAttributes="Bold" TextColor="#A5B4FC" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Insight 2: Top Region -->
            <Border Grid.Column="1" Style="{StaticResource InsightCard}" HeightRequest="88">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" VerticalOptions="Center" Padding="8,6">
                    <Border BackgroundColor="#3B82F6"
                       WidthRequest="70" HeightRequest="52"
                       VerticalOptions="Center" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Path Margin="15,5,0,0" Fill="Black" WidthRequest="50" HeightRequest="40"  Data="M23.542969,22.45802C22.734985,25.87001 21.407959,28.077012 20.090942,29.487016 23.763977,28.375016 26.799988,25.806014 28.536987,22.45802z M10.493958,22.45802C12.218994,27.951005 15.189941,29.660022 16.054993,30.047015 16.948975,29.756 20.10199,28.311998 21.610962,22.45802z M3.4629517,22.45802C5.2749634,25.951003 8.506958,28.585008 12.393982,29.612018 11.026978,28.191026 9.5439453,25.941024 8.5379639,22.45802z M24.159973,12.441993C24.270996,13.596016 24.336975,14.824014 24.302979,16.19999 24.263,17.827007 24.119995,19.268993 23.911987,20.579999L29.339966,20.579999C29.835999,19.143993 30.117981,17.611003 30.117981,16.009011 30.117981,14.775003 29.941956,13.583992 29.640991,12.441993z M9.4679565,12.441993C9.2939453,13.785012 9.2469482,15.264016 9.407959,16.921001 9.539978,18.275005 9.7419434,19.483012 9.9879761,20.579999L22.006958,20.579999C22.225952,19.280009 22.379944,17.827007 22.420959,16.152993 22.454956,14.790017 22.403992,13.560005 22.289001,12.441993z M2.3589478,12.441993C2.05896,13.583992 1.8829956,14.775003 1.8829956,16.009011 1.8829956,17.611003 2.164978,19.143993 2.6599731,20.579999L8.0739746,20.579999C7.848999,19.513011 7.6569824,18.375011 7.532959,17.104015 7.3669434,15.397989 7.4069824,13.855995 7.5769653,12.441993z M20.221985,2.5690017C21.727966,4.1199972,23.221985,6.617008,23.91095,10.564001L29.017944,10.564001C27.416992,6.7680094,24.195984,3.8139975,20.221985,2.5690017z M12.529968,2.3720102C8.2149658,3.4669819,4.6819458,6.5329931,2.9819946,10.564001L7.901001,10.564001C8.7919922,6.6609838,10.78595,4.0180075,12.529968,2.3720102z M16.095947,1.9920053C14.978943,2.6090102,11.182983,5.0700099,9.80896,10.564001L22.013977,10.564001C20.78595,4.1120016,17.180969,2.372987,16.095947,1.9920053z M15.891968,0L16.129944,0.053009032C24.891968,0.12298569 32,7.2519877 32,16.009011 32,24.770004 24.886963,31.900012 16.121948,31.966998L15.828979,31.964008C7.0869751,31.871021 0,24.753005 0,16.009011 0,7.2869913 7.0529785,0.18499745 15.765991,0.057983398z"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Margin="2,0,0,0">
                        <Label Text="{Binding Insights[1].Value}"
                       FontSize="20" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Insights[1].Name}"
                       FontSize="12" FontAttributes="Bold" TextColor="#A5B4FC" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Insight 3: Top Channel -->
            <Border Grid.Column="2" Style="{StaticResource InsightCard}" HeightRequest="88">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18" VerticalOptions="Center" Padding="8,6">
                    <Border
                BackgroundColor="#3B82F6"
                WidthRequest="70" HeightRequest="52"
                VerticalOptions="Center" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Path Margin="15,5,0,0" Fill="Black" WidthRequest="50" HeightRequest="30" Data="M0,22.299992L32,22.299992 32,26.700001 0,26.700001z M10.800018,11.9L14.900024,11.9 14.900024,19.999996 10.800018,19.999996z M16.900024,8.699995L21,8.699995 21,19.999996 16.900024,19.999996z M4.8000183,7.4999986L8.9000244,7.4999986 8.9000244,19.999996 4.8000183,19.999996z M22.700012,0L26.800018,0 26.800018,19.999996 22.700012,19.999996z" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Margin="2,0,0,0">
                        <Label Text="{Binding Insights[2].Value}"
                       FontSize="20" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Insights[2].Name}"
                       FontSize="12" FontAttributes="Bold" TextColor="#A5B4FC" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- Revenue Trend (real-time) -->
        <Border Grid.Row="2" Grid.Column="0"  Style="{StaticResource Card}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <Grid RowSpacing="20" RowDefinitions="Auto,*">
                <Label Text="Revenue Trend (real-time)" Style="{StaticResource CardTitle}" Grid.Row="0"/>
                <Chart:SfCartesianChart x:Name="chart" Grid.Row="1">
                    <Chart:SfCartesianChart.XAxes>
                        <Chart:DateTimeAxis AutoScrollingMode="End" AutoScrollingDeltaType="Months" AutoScrollingDelta="1" IntervalType="Days" Interval="1" ShowMajorGridLines="False">
                            <Chart:DateTimeAxis.LabelStyle>
                                <Chart:ChartAxisLabelStyle TextColor="LightGray"/>
                            </Chart:DateTimeAxis.LabelStyle>
                        </Chart:DateTimeAxis>
                    </Chart:SfCartesianChart.XAxes>
                    <Chart:SfCartesianChart.YAxes>
                        <Chart:NumericalAxis >
                            <Chart:NumericalAxis.LabelStyle>
                                <Chart:ChartAxisLabelStyle TextColor="LightGray"/>
                            </Chart:NumericalAxis.LabelStyle>
                        </Chart:NumericalAxis>
                    </Chart:SfCartesianChart.YAxes>
                    <Chart:LineSeries
                        ItemsSource="{Binding RevenueTrend}"
                        XBindingPath="Time"
                        YBindingPath="Value"
                        Fill="#0EA5E9"
                        StrokeWidth="2"
                        ShowMarkers="False"
                        EnableTooltip="True" />
                </Chart:SfCartesianChart>
            </Grid>
        </Border>

        <!-- Leads by Channel -->
        <Border Grid.Row="3" Grid.Column="0"  Style="{StaticResource Card}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <Grid RowSpacing="20" RowDefinitions="Auto,*">
                <Label Text="Units by Channel" Style="{StaticResource CardTitle}" Grid.Row="0"/>
                <Chart:SfCartesianChart HorizontalOptions="Fill" VerticalOptions="Fill" Grid.Row="1">
                    <Chart:SfCartesianChart.XAxes>
                        <Chart:CategoryAxis ShowMajorGridLines="False">
                            <Chart:CategoryAxis.LabelStyle>
                                <Chart:ChartAxisLabelStyle TextColor="LightGray"/>
                            </Chart:CategoryAxis.LabelStyle>
                        </Chart:CategoryAxis>
                    </Chart:SfCartesianChart.XAxes>
                    <Chart:SfCartesianChart.YAxes>
                        <Chart:NumericalAxis Minimum="0" >
                            <Chart:NumericalAxis.LabelStyle>
                                <Chart:ChartAxisLabelStyle TextColor="LightGrey" />
                            </Chart:NumericalAxis.LabelStyle>
                        </Chart:NumericalAxis>
                    </Chart:SfCartesianChart.YAxes>
                    <Chart:ColumnSeries
                        ItemsSource="{Binding LeadsByChannel}"
                        XBindingPath="Category"
                        YBindingPath="Value"
                        CornerRadius="6"
                        ShowDataLabels="True"
                        EnableTooltip="True" PaletteBrushes="{Binding LeadsBrushes}" >

                    </Chart:ColumnSeries>

                </Chart:SfCartesianChart>
            </Grid>
        </Border>

        <!-- Revenue Share by Region -->
        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*">
                <!-- Title -->
                <Label Text="Revenue Share by Region"
               Style="{StaticResource CardTitle}"
               Grid.Row="0" />

                <!-- Chart -->
                <Chart:SfCircularChart Grid.Row="1"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill">
                    <Chart:DoughnutSeries
                                ItemsSource="{Binding RevenueByRegion}"
                                XBindingPath="Category"
                                YBindingPath="Value"
                                EnableTooltip="True"
                                ShowDataLabels="True"
                                PaletteBrushes="{Binding CustomBrushes}">
                        <Chart:DoughnutSeries.DataLabelSettings>
                            <Chart:CircularDataLabelSettings UseSeriesPalette="False" />
                        </Chart:DoughnutSeries.DataLabelSettings>
                    </Chart:DoughnutSeries>

                    <Chart:SfCircularChart.Legend>
                        <Chart:ChartLegend>
                            <Chart:ChartLegend.LabelStyle>
                                <Chart:ChartLegendLabelStyle TextColor="#E5E7EB"
                                                             Margin="5"
                                                             FontFamily="PlaywriteAR-Regular"/>
                            </Chart:ChartLegend.LabelStyle>
                        </Chart:ChartLegend>
                    </Chart:SfCircularChart.Legend>
                </Chart:SfCircularChart>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
